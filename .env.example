# ── Published port ────────────────────────────────────────────────────────────
# Nominal host port of the web app (container always listens on 3000). With the
# "open ports" block of compose.override.yml it is the host side of the mapping
# (your TLS proxy forwards https://<public-host> → http://127.0.0.1:3000 with
# Host + X-Forwarded-Proto headers). Unneeded when Caddy fronts the app.
PORT=3000

# ── Pre-built image (optional — self-hosters without a source checkout) ──────
# compose.yml builds the image from source by default. To run the production
# image from GitHub, uncomment and `docker compose pull` once;
# It's recommended to pin a version tag instead of using latest (see releases).
# YASHA_IMAGE=ghcr.io/storm1er/yasha:latest

# ── Backend provider (the LLM backend; the app is its only client, never expose it) ──
# Provider type seeded on first boot while the providers table is empty:
# "lemonade" (default — adds the model-management console) or
# "openai_compatible" (any server speaking OpenAI chat/completions).
BACKEND_TYPE=lemonade
# Base URL of a running backend. The bundled Lemonade container is OFF by
# default (replicas: 0 in compose.yml): enable it in compose.override.yml to
# keep the default below, or point this at your own instance.
BACKEND_BASE_URL=http://lemonade:13305
# Optional Bearer token expected by the backend (leave empty if the server is keyless).
BACKEND_API_KEY=

# ── Admin mutations ───────────────────────────────────────────────────────────
# Gate to allow yasha write actions to the backend (pull/load/unload/delete) exposed
# by /api/admin/actions. Switch to "false" on shared backends —
# the routes then answer 503 {"error":"mutations_disabled"} without any call.
ADMIN_ALLOW_BACKEND_MUTATIONS=true

# ── better-auth (sessions, CSRF) ──────────────────────────────────────────────
# REQUIRED. Generate one: `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
# Canonical URL of this app (no trailing slash).
BETTER_AUTH_URL=http://localhost
# Comma-separated list of origins allowed to call auth endpoints.
# Add your proxy/LAN origins, e.g. https://yasha.example.com,http://10.0.0.5:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost

# ── Database (SQLite file, lives in the ./data volume) ────────────────────────
DATABASE_PATH=/data/yasha.db

# ── First-boot admin bootstrap ────────────────────────────────────────────────
# Only used to create the first user, recommended deletion after first boot
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
# Dev-mode only: comma-separated hostnames allowed to load /_next dev assets
# (HMR) cross-origin. Without it, opening the dev server via the LAN IP can
# silently stall hydration on some WebViews. Leave empty for localhost-only dev;
# set e.g. "192.0.2.10" (your LAN IP) to develop from phones on the same LAN.
ALLOWED_DEV_ORIGINS=
TZ=UTC

# ── i18n ──────────────────────────────────────────────────────────────────────
# Available for now: en,fr see messages folder
DEFAULT_LOCALE=en

# ── Optional: bundled Caddy front (enable via compose.override.yml) ──────────
# Compose.yml starts Caddy at replicas: 0; see compose.override.yml.example to
# enable it. The Caddyfile is inlined in compose.yml — no Caddyfile needed.
# CADDY_ADDRESS: address of the Yasha site.
#   ":80" (default)        → plain HTTP on port 80 (no TLS)
#   "your.domain.tld"      → automatic Let's Encrypt HTTPS (ports 80+443 must
#                            reach the container) — also set BETTER_AUTH_URL /
#                            BETTER_AUTH_TRUSTED_ORIGINS to https://your.domain.tld
# CADDY_ADDRESS=':80'

# CADDY_LEMONADE_ADDRESS: optional front for the bundled Lemonade backend.
#   unset (default)        → loopback-only inside the Caddy container (inactive)
#   ":13305"               → plain HTTP on :13305 (publish the port in the
#                            override; keep it LAN-only, no auth on Lemonade)
#   "llm.your.domain.tld"  → automatic HTTPS for the backend too
# CADDY_LEMONADE_ADDRESS=':13305'

# ── Optional: app-level rate limiting (coarse backstop) ─────────────────────
# Per-identity fixed 1-minute windows, in-memory per process. A hardened
# deployment should enforce limits at the reverse proxy instead; set
# YASHA_RATE_LIMIT=off to disable the in-app limiter entirely.
# YASHA_RATE_LIMIT=off

# Budgets per window (requests / minute):
# RATE_LIMIT_API_PER_MIN=300      # authed reads/settings
# RATE_LIMIT_AUTH_PER_MIN=30      # auth-sensitive (users, API keys, APK links)
# RATE_LIMIT_WRITE_PER_MIN=60     # threads/memory/prefs mutations
# RATE_LIMIT_HEAVY_PER_MIN=30     # chat / /v1 completions / speech
# RATE_LIMIT_HEAVY_WINDOW_MS=60000  # heavy window (raise for slow generations)

# ── Published port ────────────────────────────────────────────────────────────
# Host port published by compose for the web app (container always listens on
# 3000). Your own TLS proxy should point at this port (e.g. PORT=3333 and the
# proxy forwards https://<public-host> → http://127.0.0.1:3333 with Host +
# X-Forwarded-Proto headers).
PORT=3000

# ── Production image (compose.prod.yml only) ─────────────────────────────────
# Pre-built image to run — self-hosters use compose.prod.yml (+ optionally
# compose.prod.caddy.yml) and need NO source checkout. Built by CI and published
# to GitHub Container Registry; pin a version tag (see releases).
# Unused when running from source (compose.yml builds the image locally).
# YASHA_IMAGE=ghcr.io/storm1er/yasha:latest

# ── Lemonade server (the LLM backend; app is the only client, never expose it) ──
# Base URL of a running Lemonade Server.
LEMONADE_BASE_URL=http://lemonade:13305
# Optional Bearer token expected by Lemonade (leave empty if the server is keyless).
LEMONADE_API_KEY=

# ── Admin mutations (P5a) ─────────────────────────────────────────────────────
# Gate for admin-only MUTATING Lemonade calls (pull/load/unload/delete) exposed
# by /api/admin/actions. Switch to "false" on shared Lemonade servers —
# the routes then answer 503 {"error":"mutations_disabled"} without any call.
ADMIN_ALLOW_MUTATIONS=true

# ── better-auth (sessions, CSRF) ──────────────────────────────────────────────
# REQUIRED. Generate one: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
# Canonical URL of this app (no trailing slash).
BETTER_AUTH_URL=http://localhost
# Comma-separated list of origins allowed to call auth endpoints.
# Add your proxy/LAN origins, e.g. https://yasha.example.com,http://10.0.0.5:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost

# ── Database (SQLite file, lives in the ./data volume) ────────────────────────
DATABASE_PATH=/data/yasha.db

# ── First-boot admin bootstrap (only used while the users table is empty) ─────
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
# Dev-mode only: comma-separated hostnames allowed to load /_next dev assets
# (HMR) cross-origin. Without it, opening the dev server via the LAN IP can
# silently stall hydration on some WebViews. Leave empty for localhost-only dev;
# set e.g. "192.0.2.10" (your LAN IP) to develop from phones on the same LAN.
ALLOWED_DEV_ORIGINS=
TZ=UTC

# ── i18n ──────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=en

# ── Optional: bundled Caddy proxy (compose.caddy.yml overlay) ─────────────────
# Only used when starting with:
#   docker compose -f compose.yml -f compose.caddy.yml up -d
# Bare-host default: plain HTTP on :80. For AUTOMATIC HTTPS (free Let's Encrypt
# certs): set "your.domain.tld" and make sure ports 80+443 reach the container.
# Leave unset if you run your own TLS proxy (default single-stack path).
# CADDY_ADDRESS=':80'

# ── Optional: app-level rate limiting (coarse backstop) ─────────────────────
# Per-identity fixed 1-minute windows, in-memory per process. A hardened
# deployment should enforce limits at the reverse proxy instead; set
# YASHA_RATE_LIMIT=off to disable the in-app limiter entirely.
# YASHA_RATE_LIMIT=off
# Budgets per window (requests / minute):
# RATE_LIMIT_API_PER_MIN=300      # authed reads/settings
# RATE_LIMIT_AUTH_PER_MIN=30      # auth-sensitive (users, API keys, APK links)
# RATE_LIMIT_WRITE_PER_MIN=60     # threads/memory/prefs mutations
# RATE_LIMIT_HEAVY_PER_MIN=30     # chat / /v1 completions / speech
# RATE_LIMIT_HEAVY_WINDOW_MS=60000  # heavy window (raise for slow generations)
